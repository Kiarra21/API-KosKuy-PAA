                "summary": "Buat cabang baru",
                "description": "Access: Pemilik Kos only",
                "operationId": "createBranch",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "description",
                                    "address",
                                    "longitude",
                                    "latitude",
                                    "phone",
                                    "qris_code"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Cabang A"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Deskripsi cabang"
                                    },
                                    "address": {
                                        "type": "string",
                                        "example": "Jl. Mawar"
                                    },
                                    "longitude": {
                                        "type": "string",
                                        "example": "106.827"
                                    },
                                    "latitude": {
                                        "type": "string",
                                        "example": "-6.175"
                                    },
                                    "phone": {
                                        "type": "string",
                                        "example": "08123456789"
                                    },
                                    "qris_code": {
                                        "type": "string",
                                        "example": "qris-123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
